import React, { useState } from "react";
import { Dialog, DialogContent, DialogHeader, DialogTitle } from "@/components/ui/dialog";
import { Button } from "@/components/ui/button";
import { Label } from "@/components/ui/label";
import { Input } from "@/components/ui/input";
import { Switch } from "@/components/ui/switch";
import { Card, CardContent } from "@/components/ui/card";
import { AlertCircle, Zap, Shield, Calendar } from "lucide-react";

export default function AutoPaySettings({ open, onClose, bill, onUpdate }) {
  const [autoPayEnabled, setAutoPayEnabled] = useState(bill?.auto_pay_enabled || false);
  const [reminderDays, setReminderDays] = useState(bill?.reminder_days_before || 3);
  const [isSaving, setIsSaving] = useState(false);

  const handleSave = async () => {
    setIsSaving(true);
    try {
      await onUpdate(bill.id, {
        auto_pay_enabled: autoPayEnabled,
        reminder_days_before: parseInt(reminderDays)
      });
      alert(`Auto-pay ${autoPayEnabled ? 'enabled' : 'disabled'} successfully!`);
      onClose();
    } catch (error) {
      console.error('Error updating auto-pay settings:', error);
      alert('Failed to update settings. Please try again.');
    } finally {
      setIsSaving(false);
    }
  };

  return (
    <Dialog open={open} onOpenChange={onClose}>
      <DialogContent className="max-w-2xl">
        <DialogHeader>
          <DialogTitle className="text-2xl">Auto-Pay Settings</DialogTitle>
        </DialogHeader>

        <div className="space-y-6">
          {/* Bill Info */}
          <Card className="bg-gradient-to-r from-blue-50 to-indigo-50 border-blue-200">
            <CardContent className="p-4">
              <h3 className="font-bold text-blue-900 mb-1">{bill?.bill_name}</h3>
              <p className="text-sm text-blue-800">
                ${bill?.amount?.toFixed(2)} • {bill?.frequency}
              </p>
            </CardContent>
          </Card>

          {/* Auto-Pay Toggle */}
          <div className="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
            <div className="flex items-center gap-3">
              <Zap className="w-6 h-6 text-yellow-600" />
              <div>
                <h4 className="font-semibold text-gray-900">Enable Auto-Pay</h4>
                <p className="text-sm text-gray-600">
                  Automatically pay this bill on the due date
                </p>
              </div>
            </div>
            <Switch
              checked={autoPayEnabled}
              onCheckedChange={setAutoPayEnabled}
            />
          </div>

          {autoPayEnabled && (
            <>
              {/* Reminder Settings */}
              <div className="space-y-3">
                <Label>Reminder Days Before Due Date</Label>
                <Input
                  type="number"
                  min="1"
                  max="30"
                  value={reminderDays}
                  onChange={(e) => setReminderDays(e.target.value)}
                />
                <p className="text-sm text-gray-600">
                  You'll receive a notification {reminderDays} days before the payment is processed
                </p>
              </div>

              {/* Info Cards */}
              <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                <Card className="bg-green-50 border-green-200">
                  <CardContent className="p-4">
                    <div className="flex items-start gap-3">
                      <Calendar className="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5" />
                      <div className="text-sm text-green-800">
                        <p className="font-semibold mb-1">Scheduled Payment</p>
                        <p>Payments will be processed automatically on the due date at 6:00 AM</p>
                      </div>
                    </div>
                  </CardContent>
                </Card>

                <Card className="bg-purple-50 border-purple-200">
                  <CardContent className="p-4">
                    <div className="flex items-start gap-3">
                      <Shield className="w-5 h-5 text-purple-600 flex-shrink-0 mt-0.5" />
                      <div className="text-sm text-purple-800">
                        <p className="font-semibold mb-1">Secure Processing</p>
                        <p>All payments are processed securely through Stripe with bank-level encryption</p>
                      </div>
                    </div>
                  </CardContent>
                </Card>
              </div>

              {/* Warning */}
              <Card className="bg-yellow-50 border-yellow-300">
                <CardContent className="p-4">
                  <div className="flex items-start gap-3">
                    <AlertCircle className="w-5 h-5 text-yellow-600 flex-shrink-0 mt-0.5" />
                    <div className="text-sm text-yellow-800">
                      <p className="font-semibold mb-1">Important Information</p>
                      <ul className="space-y-1 ml-4 list-disc">
                        <li>Ensure sufficient funds are available before the due date</li>
                        <li>You can cancel auto-pay anytime before the payment is processed</li>
                        <li>Failed payments will send you a notification</li>
                        <li>You'll receive confirmation after each successful payment</li>
                      </ul>
                    </div>
                  </div>
                </CardContent>
              </Card>
            </>
          )}

          {/* Actions */}
          <div className="flex gap-3 pt-4">
            <Button onClick={onClose} variant="outline" className="flex-1">
              Cancel
            </Button>
            <Button 
              onClick={handleSave} 
              disabled={isSaving}
              className="flex-1 bg-gradient-to-r from-blue-600 to-indigo-600"
            >
              {isSaving ? 'Saving...' : 'Save Settings'}
            </Button>
          </div>
        </div>
      </DialogContent>
    </Dialog>
  );
}

import React from "react";
import { Dialog, DialogContent, DialogHeader, DialogTitle } from "@/components/ui/dialog";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { Trash2, CheckCircle2, Calendar, DollarSign } from "lucide-react";
import { format } from "date-fns";

export default function BillDetails({ bill, onClose, onUpdate, onDelete }) {
  const daysUntilDue = Math.ceil((new Date(bill.due_date) - new Date()) / (1000 * 60 * 60 * 24));
  const isOverdue = daysUntilDue < 0;

  const handleMarkPaid = async () => {
    await onUpdate(bill.id, { 
      status: 'paid',
      last_paid_date: new Date().toISOString().split('T')[0]
    });
  };

  return (
    <Dialog open={true} onOpenChange={onClose}>
      <DialogContent className="max-w-2xl">
        <DialogHeader>
          <DialogTitle className="flex items-center justify-between">
            <span>{bill.bill_name}</span>
            <Badge variant={bill.status === 'paid' ? 'default' : isOverdue ? 'destructive' : 'secondary'} className="capitalize">
              {bill.status}
            </Badge>
          </DialogTitle>
        </DialogHeader>

        <div className="space-y-6">
          {/* Amount Section */}
          <div className="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-xl p-6 text-center">
            <p className="text-sm text-gray-600 mb-2">Amount Due</p>
            <p className="text-4xl font-bold text-gray-900">${bill.amount.toFixed(2)}</p>
            <p className="text-sm text-gray-600 mt-2 capitalize">{bill.frequency} payment</p>
          </div>

          {/* Details */}
          <div className="grid grid-cols-2 gap-4">
            <div className="p-4 bg-gray-50 rounded-lg">
              <div className="flex items-center gap-2 mb-2">
                <Calendar className="w-4 h-4 text-gray-400" />
                <p className="text-sm text-gray-600">Due Date</p>
              </div>
              <p className="font-bold">{format(new Date(bill.due_date), 'MMM d, yyyy')}</p>
              <p className={`text-sm mt-1 ${isOverdue ? 'text-red-600' : 'text-gray-600'}`}>
                {isOverdue ? `Overdue by ${Math.abs(daysUntilDue)} days` : `${daysUntilDue} days left`}
              </p>
            </div>

            <div className="p-4 bg-gray-50 rounded-lg">
              <div className="flex items-center gap-2 mb-2">
                <DollarSign className="w-4 h-4 text-gray-400" />
                <p className="text-sm text-gray-600">Category</p>
              </div>
              <p className="font-bold capitalize">{bill.category}</p>
              {bill.merchant && (
                <p className="text-sm text-gray-600 mt-1">{bill.merchant}</p>
              )}
            </div>
          </div>

          {/* Settings */}
          <div className="space-y-3">
            <div className="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
              <span className="text-sm">Reminder</span>
              <span className="text-sm font-medium">{bill.reminder_days_before} days before</span>
            </div>
            
            <div className="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
              <span className="text-sm">Auto-Pay</span>
              <Badge variant={bill.auto_pay_enabled ? 'default' : 'secondary'}>
                {bill.auto_pay_enabled ? 'Enabled' : 'Disabled'}
              </Badge>
            </div>

            {bill.last_paid_date && (
              <div className="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                <span className="text-sm">Last Paid</span>
                <span className="text-sm font-medium">{format(new Date(bill.last_paid_date), 'MMM d, yyyy')}</span>
              </div>
            )}
          </div>

          {/* Notes */}
          {bill.notes && (
            <div className="bg-gray-50 rounded-lg p-4">
              <p className="text-sm font-medium text-gray-600 mb-2">Notes</p>
              <p className="text-gray-900">{bill.notes}</p>
            </div>
          )}

          {/* Actions */}
          <div className="flex gap-3 justify-between pt-4 border-t">
            <Button
              variant="destructive"
              onClick={() => onDelete(bill.id)}
            >
              <Trash2 className="w-4 h-4 mr-2" />
              Delete Bill
            </Button>
            
            {bill.status !== 'paid' && (
              <Button
                className="bg-green-600 hover:bg-green-700"
                onClick={handleMarkPaid}
              >
                <CheckCircle2 className="w-4 h-4 mr-2" />
                Mark as Paid
              </Button>
            )}
          </div>
        </div>
      </DialogContent>
    </Dialog>
  );
}

import React, { useState } from "react";
import { Card, CardContent } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Calendar, DollarSign, CheckCircle2, Zap } from "lucide-react";
import { format } from "date-fns";
import AutoPaySettings from "./AutoPaySettings";

const CATEGORY_ICONS = {
  utilities: "⚡",
  rent: "🏠",
  subscription: "📱",
  insurance: "🛡️",
  loan: "🏦",
  credit_card: "💳",
  other: "📋"
};

const CATEGORY_COLORS = {
  utilities: "from-yellow-500 to-orange-500",
  rent: "from-blue-500 to-indigo-500",
  subscription: "from-purple-500 to-pink-500",
  insurance: "from-green-500 to-emerald-500",
  loan: "from-red-500 to-rose-500",
  credit_card: "from-cyan-500 to-blue-500",
  other: "from-gray-500 to-slate-500"
};

export default function BillsList({ bills, onBillClick, onUpdateBill }) {
  const [autoPayBill, setAutoPayBill] = useState(null);

  const handleMarkAsPaid = async (e, bill) => {
    e.stopPropagation();
    await onUpdateBill(bill.id, { 
      status: 'paid',
      last_paid_date: new Date().toISOString().split('T')[0]
    });
  };

  const handleAutoPayClick = (e, bill) => {
    e.stopPropagation();
    setAutoPayBill(bill);
  };

  return (
    <>
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {bills.map((bill) => {
        const dueDate = new Date(bill.due_date);
        const daysUntilDue = Math.ceil((dueDate - new Date()) / (1000 * 60 * 60 * 24));
        const isOverdue = daysUntilDue < 0;
        const isDueSoon = daysUntilDue <= 3 && daysUntilDue >= 0;

        return (
          <Card 
            key={bill.id}
            className="bg-white/80 backdrop-blur-sm border-0 shadow-xl hover:shadow-2xl transition-all cursor-pointer group"
            onClick={() => onBillClick(bill)}
          >
            <CardContent className="p-6">
              {/* Header */}
              <div className="flex items-start justify-between mb-4">
                <div className="flex items-center gap-3">
                  <div className={`w-12 h-12 bg-gradient-to-r ${CATEGORY_COLORS[bill.category]} rounded-full flex items-center justify-center text-2xl`}>
                    {CATEGORY_ICONS[bill.category]}
                  </div>
                  <div>
                    <h3 className="font-bold text-gray-900">{bill.bill_name}</h3>
                    <p className="text-sm text-gray-500 capitalize">{bill.category}</p>
                  </div>
                </div>
              </div>

              {/* Amount */}
              <div className="mb-4">
                <div className="flex items-center justify-between">
                  <span className="text-sm text-gray-600">Amount</span>
                  <span className="text-2xl font-bold text-gray-900">${bill.amount.toFixed(2)}</span>
                </div>
                <p className="text-xs text-gray-500 text-right capitalize">{bill.frequency}</p>
              </div>

              {/* Due Date */}
              <div className="flex items-center justify-between mb-4 p-3 bg-gray-50 rounded-lg">
                <div className="flex items-center gap-2">
                  <Calendar className="w-4 h-4 text-gray-400" />
                  <span className="text-sm text-gray-600">Due Date</span>
                </div>
                <span className={`text-sm font-medium ${
                  isOverdue ? 'text-red-600' : isDueSoon ? 'text-orange-600' : 'text-gray-900'
                }`}>
                  {format(dueDate, 'MMM d, yyyy')}
                </span>
              </div>

              {/* Status Info */}
              <div className="mb-4">
                {isOverdue && (
                  <Badge variant="destructive" className="w-full justify-center">
                    Overdue by {Math.abs(daysUntilDue)} days
                  </Badge>
                )}
                {isDueSoon && !isOverdue && (
                  <Badge className="w-full justify-center bg-orange-500">
                    Due in {daysUntilDue} days
                  </Badge>
                )}
                {!isOverdue && !isDueSoon && (
                  <Badge variant="secondary" className="w-full justify-center">
                    {daysUntilDue} days until due
                  </Badge>
                )}
              </div>

              {/* Actions */}
              {bill.status === 'active' && (
                <div className="space-y-2">
                  <Button
                    size="sm"
                    className="w-full bg-green-600 hover:bg-green-700"
                    onClick={(e) => handleMarkAsPaid(e, bill)}
                  >
                    <CheckCircle2 className="w-4 h-4 mr-2" />
                    Mark as Paid
                  </Button>
                  <Button
                    size="sm"
                    variant="outline"
                    className="w-full"
                    onClick={(e) => handleAutoPayClick(e, bill)}
                  >
                    <Zap className="w-4 h-4 mr-2" />
                    {bill.auto_pay_enabled ? 'Manage' : 'Enable'} Auto-Pay
                  </Button>
                </div>
              )}

              {bill.auto_pay_enabled && (
                <div className="mt-3 p-2 bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 rounded text-center">
                  <p className="text-xs text-blue-700 font-medium flex items-center justify-center gap-1">
                    <Zap className="w-3 h-3" />
                    Auto-Pay Active
                  </p>
                </div>
              )}
            </CardContent>
          </Card>
        );
      })}
      </div>

      {autoPayBill && (
        <AutoPaySettings
          open={!!autoPayBill}
          onClose={() => setAutoPayBill(null)}
          bill={autoPayBill}
          onUpdate={onUpdateBill}
        />
      )}
    </>
  );
}

import React, { useState } from "react";
import { Dialog, DialogContent, DialogHeader, DialogTitle } from "@/components/ui/dialog";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
