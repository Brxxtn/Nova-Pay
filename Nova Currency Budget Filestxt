import { PiggyBank, Sparkles, Loader2, TrendingDown, Target, AlertTriangle } from "lucide-react";
import { Progress } from "@/components/ui/progress";
import { Badge } from "@/components/ui/badge";

export default function BudgetRecommendations({ transactions, account, user }) {
  const [recommendations, setRecommendations] = useState(null);
  const [isAnalyzing, setIsAnalyzing] = useState(false);

  const analyzeBudget = async () => {
    setIsAnalyzing(true);
    try {
      // Calculate current spending patterns
      const last30Days = transactions.filter(t => {
        const txDate = new Date(t.created_date);
        const daysAgo = (Date.now() - txDate.getTime()) / (1000 * 60 * 60 * 24);
        return daysAgo <= 30;
      });

      const spendingByCategory = {};
      const incomeByCategory = {};
      
      last30Days.forEach(t => {
        const category = t.category || 'other';
        if (['debit', 'transfer_out'].includes(t.type)) {
          spendingByCategory[category] = (spendingByCategory[category] || 0) + Math.abs(t.amount);
        } else if (['credit', 'transfer_in'].includes(t.type)) {
          incomeByCategory[category] = (incomeByCategory[category] || 0) + t.amount;
        }
      });

      const totalSpent = Object.values(spendingByCategory).reduce((sum, val) => sum + val, 0);
      const totalIncome = Object.values(incomeByCategory).reduce((sum, val) => sum + val, 0);

      const prompt = `As a financial advisor, analyze this user's spending and create a personalized budget recommendation.

User Financial Data:
- Current Balance: $${account?.balance || 0}
- Monthly Income: $${totalIncome.toFixed(2)}
- Monthly Spending: $${totalSpent.toFixed(2)}
- Spending by Category: ${JSON.stringify(spendingByCategory)}

Provide recommendations in this JSON format:
{
  "monthly_income_estimate": number,
  "recommended_budgets": {
    "food": number,
    "shopping": number,
    "gas": number,
    "entertainment": number,
    "bills": number,
    "savings": number
  },
  "savings_goal": {
    "monthly_amount": number,
    "percentage": number,
    "reasoning": "why this amount"
  },
  "spending_insights": [
    {"category": "food", "current": number, "recommended": number, "status": "over/under/good", "tip": "specific advice"}
  ],
  "priority_actions": [
    {"action": "what to do", "impact": "high/medium/low", "difficulty": "easy/medium/hard"}
  ],
  "financial_health_score": number (0-100)
}

Be specific, realistic, and actionable. Consider the 50/30/20 rule but adapt to their actual situation.`;

      const response = await base44.integrations.Core.InvokeLLM({
        prompt: prompt,
        response_json_schema: {
          type: "object",
          properties: {
            monthly_income_estimate: { type: "number" },
            recommended_budgets: {
              type: "object",
              properties: {
                food: { type: "number" },
                shopping: { type: "number" },
                gas: { type: "number" },
                entertainment: { type: "number" },
                bills: { type: "number" },
                savings: { type: "number" }
              }
            },
            savings_goal: {
              type: "object",
              properties: {
                monthly_amount: { type: "number" },
                percentage: { type: "number" },
                reasoning: { type: "string" }
              }
            },
            spending_insights: {
              type: "array",
              items: {
                type: "object",
                properties: {
                  category: { type: "string" },
                  current: { type: "number" },
                  recommended: { type: "number" },
                  status: { type: "string" },
                  tip: { type: "string" }
                }
              }
            },
            priority_actions: {
              type: "array",
              items: {
                type: "object",
                properties: {
                  action: { type: "string" },
                  impact: { type: "string" },
                  difficulty: { type: "string" }
                }
              }
            },
            financial_health_score: { type: "number" }
          }
        }
      });

      setRecommendations(response);
    } catch (error) {
      console.error("Error analyzing budget:", error);
      alert("Failed to analyze budget. Please try again.");
    } finally {
      setIsAnalyzing(false);
    }
  };

  const getStatusColor = (status) => {
    switch (status?.toLowerCase()) {
      case 'good': return 'bg-green-100 text-green-800';
      case 'over': return 'bg-red-100 text-red-800';
      case 'under': return 'bg-blue-100 text-blue-800';
      default: return 'bg-gray-100 text-gray-800';
    }
  };

  const getImpactColor = (impact) => {
    switch (impact?.toLowerCase()) {
      case 'high': return 'bg-red-100 text-red-800';
      case 'medium': return 'bg-yellow-100 text-yellow-800';
      case 'low': return 'bg-green-100 text-green-800';
      default: return 'bg-gray-100 text-gray-800';
    }
  };

  const getHealthColor = (score) => {
    if (score >= 80) return 'text-green-600';
    if (score >= 60) return 'text-yellow-600';
    return 'text-red-600';
  };

  return (
    <Card className="bg-gradient-to-br from-green-50 via-emerald-50 to-teal-50 border-green-200 shadow-xl">
      <CardHeader>
        <CardTitle className="flex items-center gap-2">
          <PiggyBank className="w-6 h-6 text-green-600" />
          AI Budget Recommendations
          <Sparkles className="w-4 h-4 text-yellow-500" />
        </CardTitle>
      </CardHeader>
      <CardContent className="space-y-4">
        {!recommendations ? (
          <>
            <p className="text-sm text-gray-600">
              Get personalized budget recommendations based on your spending patterns and financial goals.
            </p>
            <Button
              onClick={analyzeBudget}
              disabled={isAnalyzing}
              className="w-full bg-gradient-to-r from-green-600 to-emerald-600"
            >
              {isAnalyzing ? (
                <>
                  <Loader2 className="w-4 h-4 mr-2 animate-spin" />
                  Analyzing Your Budget...
                </>
              ) : (
                <>
                  <Sparkles className="w-4 h-4 mr-2" />
                  Generate Budget Plan
                </>
              )}
            </Button>
          </>
        ) : (
          <div className="space-y-4">
            {/* Financial Health Score */}
            <div className="bg-white rounded-lg p-4">
              <div className="flex items-center justify-between mb-2">
                <h3 className="font-semibold">Financial Health Score</h3>
                <span className={`text-2xl font-bold ${getHealthColor(recommendations.financial_health_score)}`}>
                  {recommendations.financial_health_score}/100
                </span>
              </div>
              <Progress value={recommendations.financial_health_score} className="h-2" />
            </div>

            {/* Savings Goal */}
            <div className="bg-white rounded-lg p-4">
              <h3 className="font-semibold mb-2 flex items-center gap-2">
                <Target className="w-4 h-4" />
                Savings Goal
              </h3>
              <div className="flex items-center justify-between mb-2">
                <span className="text-sm text-gray-600">Monthly Target</span>
                <span className="text-xl font-bold text-green-600">
                  ${recommendations.savings_goal?.monthly_amount?.toFixed(0)}
                </span>
              </div>
              <div className="flex items-center justify-between mb-2">
                <span className="text-sm text-gray-600">Savings Rate</span>
                <Badge className="bg-green-100 text-green-800">
                  {recommendations.savings_goal?.percentage?.toFixed(1)}%
                </Badge>
              </div>
              <p className="text-xs text-gray-600 mt-2">{recommendations.savings_goal?.reasoning}</p>
            </div>

            {/* Recommended Budgets */}
            <div className="bg-white rounded-lg p-4">
              <h3 className="font-semibold mb-3">Recommended Monthly Budgets</h3>
              <div className="space-y-2">
                {Object.entries(recommendations.recommended_budgets || {}).map(([category, amount]) => (
                  <div key={category} className="flex items-center justify-between">
                    <span className="text-sm capitalize">{category}</span>
                    <span className="font-medium">${amount.toFixed(0)}</span>
                  </div>
                ))}
              </div>
            </div>

            {/* Spending Insights */}
            <div className="bg-white rounded-lg p-4">
              <h3 className="font-semibold mb-3 flex items-center gap-2">
                <TrendingDown className="w-4 h-4" />
                Spending Analysis
              </h3>
              <div className="space-y-3">
                {recommendations.spending_insights?.map((insight, idx) => (
                  <div key={idx} className="p-3 bg-gray-50 rounded-lg">
                    <div className="flex items-center justify-between mb-2">
                      <span className="font-medium capitalize">{insight.category}</span>
                      <Badge className={getStatusColor(insight.status)}>
                        {insight.status}
                      </Badge>
                    </div>
                    <div className="flex items-center justify-between text-sm mb-1">
                      <span className="text-gray-600">Current: ${insight.current?.toFixed(0)}</span>
                      <span className="text-gray-600">Target: ${insight.recommended?.toFixed(0)}</span>
                    </div>
                    <Progress 
                      value={insight.recommended ? (insight.current / insight.recommended) * 100 : 0} 
                      className="h-1 mb-2"
                    />
                    <p className="text-xs text-gray-600">{insight.tip}</p>
                  </div>
                ))}
              </div>
            </div>

            {/* Priority Actions */}
            <div className="bg-white rounded-lg p-4">
              <h3 className="font-semibold mb-3 flex items-center gap-2">
                <AlertTriangle className="w-4 h-4" />
                Priority Actions
              </h3>
              <div className="space-y-2">
                {recommendations.priority_actions?.map((action, idx) => (
                  <div key={idx} className="flex items-start gap-3 p-3 bg-gray-50 rounded-lg">
                    <div className="flex-1">
                      <p className="text-sm font-medium mb-1">{action.action}</p>
                      <div className="flex gap-2">
                        <Badge className={getImpactColor(action.impact)} size="sm">
                          {action.impact} impact
                        </Badge>
                        <Badge variant="outline" size="sm">
                          {action.difficulty} difficulty
                        </Badge>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <Button
              onClick={() => setRecommendations(null)}
              variant="outline"
              className="w-full"
            >
              Generate New Plan
            </Button>
          </div>
        )}
      </CardContent>
    </Card>
  );
}
